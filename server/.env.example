# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your deployed app URL, http://localhost:19006 for Expo web, etc.)
CORS_ORIGIN=*

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=fitforge
DB_PASSWORD=changeme
DB_NAME=fitforge

# --- JWT ---
# Generate a strong random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Email (Resend) ---
# 1. Sign up free at resend.com
# 2. Dashboard -> API Keys -> Create API Key -> paste it below
# 3. While your account has no verified domain, Resend only lets you send TO the
#    email address your Resend account is registered under, and FROM their shared
#    testing address (onboarding@resend.dev) — both are already set correctly below
#    for that stage. Once you verify a domain at resend.com/domains, change
#    RESEND_FROM to an address on that domain and you can email anyone.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="FitForge <onboarding@resend.dev>"
