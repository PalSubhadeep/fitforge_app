# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your deployed app URL, http://localhost:19006 for Expo web, etc.)
CORS_ORIGIN=*

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=fitforge
DB_PASSWORD=changeme
DB_NAME=fitforge

# --- JWT ---
# Generate a strong random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Email (SMTP via Gmail App Password) ---
# 1. Turn on 2-Step Verification on the Gmail account you'll send from:
#    myaccount.google.com/security
# 2. Create an App Password: myaccount.google.com/apppasswords
#    (choose "Mail" as the app — you'll get a 16-character password)
# 3. Fill in SMTP_USER with your full Gmail address, and SMTP_PASS with that
#    16-character app password (not your normal Google password).
# Unlike Resend's free tier, a Gmail App Password can send to ANY recipient
# address immediately — no domain verification or "only your own email" limit.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16characterapppassword
SMTP_FROM="FitForge <youraddress@gmail.com>"
