# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your deployed app URL, http://localhost:19006 for Expo web, etc.)
CORS_ORIGIN=*

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=fitforge
DB_PASSWORD=changeme
DB_NAME=fitforge

# --- JWT ---
# Generate a strong random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Email (Brevo transactional email API) ---
# Raw SMTP (nodemailer + Gmail App Password) is unreliable on Railway — the
# outbound SMTP socket can stall and never respond, which makes signup look like
# a network error even though the server is healthy. Brevo's HTTPS API avoids that.
# 1. Create a free Brevo account: https://app.brevo.com (300 emails/day free, forever).
# 2. Settings -> SMTP & API -> API Keys -> generate a key -> BREVO_API_KEY.
# 3. Senders, Domains & Dedicated IPs -> Senders -> add the email you want to send
#    from, then click the confirmation link Brevo emails you.
# Unlike Resend's free tier, once that ONE sender email is verified you can send
# to ANY recipient immediately — no domain verification needed.
BREVO_API_KEY=your-brevo-api-key
SMTP_FROM=youraddress@example.com
BREVO_SENDER_NAME=FitForge
